# VITE_* variables are bundled into the client JavaScript and are PUBLIC.
# Never put secrets here.
#
# Dev: the Vite dev server proxies /api → VITE_DEV_PROXY_TARGET (the Laravel API at
# http://127.0.0.1:8080), so the browser talks same-origin and needs no CORS config.
# For an Android debug build against a dev machine, override in .env.development.local, e.g.
#   VITE_API_BASE_URL=http://10.0.2.2:8080/api/v1   (emulator → host)
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
VITE_APP_ENV=development
