<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (src/debug overrides src/main). Allows plain HTTP to development hosts:
  the emulator's host loopback (10.0.2.2), localhost, and LAN dev machines (private IPs cannot
  be enumerated in domain-config, so cleartext is permitted for the debug build as a whole).
  Release builds use src/main/res/xml/network_security_config.xml (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
