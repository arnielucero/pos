APP_NAME="HMR POS API"
# local | production. In production: APP_DEBUG=false (never leak stack traces), HTTPS is forced + HSTS sent.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# Lets `php artisan serve` handle parallel requests locally (default is a single worker).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite). Production target is MySQL 8:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pos
# DB_USERNAME=pos
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- POS ---
# Comma-separated list of origins allowed by CORS (Vite dev server, Capacitor Android/iOS WebViews).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
POS_ACCESS_TOKEN_TTL_MINUTES=720
POS_REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost for approver PINs shipped to devices via /sync/pull (must stay >= 12 in production).
POS_PIN_BCRYPT_ROUNDS=12

MAIL_MAILER=log

# Login attempts per minute per (email, ip). Keep 5 in production; raise only for local E2E runs.
POS_LOGIN_RATE_LIMIT=5
